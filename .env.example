PORT=8082
HOST=127.0.0.1
# Set PUBLIC_ORIGIN to your HTTPS app URL if you deploy behind a proxy.
PUBLIC_ORIGIN=
# Required for public mode. Generate 32 random bytes and encode as base64url.
SESSION_ENCRYPTION_KEY=

# Leave both empty to use a local SQLite demo workspace. Use a publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Match the Supabase Confirm signup template. Use code only when the template sends an OTP.
SUPABASE_EMAIL_CONFIRMATION=link
# Set to code after configuring the Reset password template to send {{ .Token }}.
SUPABASE_PASSWORD_RECOVERY=

# Live mode uses Twelve Data for closing prices and SEC EDGAR for filings.
MARKET_DATA_MODE=demo
TWELVE_DATA_API_KEY=
SEC_USER_AGENT=

# Set the key and model ID for each provider you want to enable.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
